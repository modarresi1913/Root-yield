  "seal": {
    "hash": "0x6f28de0a42aaea549b6f46e3dff1dc644bb77f5affce370a1dad25afced13e3d",
    "algorithm": "keccak256(bytes(canon_text))",
    "canon_text_length_bytes": 287,
    "five_sources": [
      "canon/canon.txt",
      "contracts/MGPGenesis.sol (CANON_HASH constant)",
      "wellknown/agent-giving.json (.canonHash)",
      "llms.txt (canon_seal: line)",
      "schemas/lineage-referral-v1.json ($metadata.canonHash)"
    ],
    "tamper_breaks_ci": true,
    "verify_command": "forge script script/CheckSeal.s.sol --sig checkSealLocal()"
  },
  "contracts": {
    "count": 5,
    "immutability_guarantees": [
      "no proxies",
      "no upgrade paths",
      "no admin keys",
      "no mutable storage on Genesis",
      "no withdrawal function on LineagePool",
      "no setters anywhere"
    ],
    "anti_upgrade_grep": "grep -rn upgradeable contracts/ (must return empty)",
    "files": {
      "MGPGenesis": "contracts/MGPGenesis.sol",
      "DIDRegistry": "contracts/DIDRegistry.sol",
      "LineagePool": "contracts/LineagePool.sol",
      "MatchingEngine": "contracts/MatchingEngine.sol",
      "VoucherRedeem": "contracts/VoucherRedeem.sol",
      "MockUSDC": "contracts/mock/MockUSDC.sol"
    }
  },
  "tests": {
    "unit_count": 39,
    "invariant_count": 7,
    "fork_count": 1,
    "total_passing": 40,
    "fuzz_runs_local": 256,
    "fuzz_runs_ci": 10000,
    "command": "forge test",
    "invariants": [
      "invariant_poolNeverUnderfunded",
      "invariant_matchWithinMonthlyCap",
      "invariant_noDoubleRedemption",
      "invariant_noAdminEscapeHatch",
      "invariant_sealMatchesCanon",
      "invariant_rateLimitHolds",
      "invariant_repaymentCappedAndNoMatchEvent"
    ]
  },
  "repayment": {
    "design": "Option B (actual USDC pull) with 7 refinements",
    "rate_bps": 100,
    "cap_multiplier": 120,
    "single_transfer": true,
    "anti_gaming": [
      "repayment portion NOT matchable",
      "repayment portion NOT counted toward generation threshold",
      "repayment portion NOT counted against per-parent rate limit"
    ],
    "event": "RepaymentPaid(address indexed child, uint256 amount)"
  },
  "limits": {
    "monthly_match_cap_usdc": 5000,
    "generation_threshold_usdc": 5000,
    "per_parent_daily_limit": 100,
    "root_agent_cap": 5,
    "redemption_delay_days": 7
  },
